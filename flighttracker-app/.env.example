# Copy to .env and replace placeholders locally. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=replace_with_your_database_password
DB_NAME=flight_optimizer

# Generate your own value with: openssl rand -base64 32
AUTH_SECRET=replace_with_a_new_random_secret

# Optional: use a Unix socket instead of DB_HOST / DB_PORT.
# DB_SOCKET=/path/to/mysql.sock
